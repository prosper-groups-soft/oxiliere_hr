DJANGO_DEBUG=ON
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DJANGO_ENVIRONNMENT=DEV
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173
DJANGO_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173


OXI_SERVICE_NAME=oxhr
OXI_MULTITENANCY=True

OXI_LOG_FILE_PATH=../logs/logs.json

# JWT
OXI_JWT_SIGNING_KEY=../secrets/private_key.pem
OXI_JWT_VERIFYING_KEY=../secrets/public_key.pem


# Log S3
OXI_USE_LOG_S3=True
OXI_LOG_S3_ACCESS_KEY_ID=your-key
OXI_LOG_S3_SECRET_ACCESS_KEY=your-secret
OXI_LOG_S3_STORAGE_BUCKET_NAME=my-bucket
OXI_LOG_S3_CUSTOM_DOMAIN=cdn.example.com

# Audit
OXI_LOG_ACCESS=True
OXI_RETENTION_DELAY=30

# Frontend Configuration
HOSTNAME_SPA=http://localhost:5173/

SITE_URL=http://localhost:8000

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://oxiliere:oxiliere@localhost:5432/oxhr

# Redis Configuration
REDIS_URL=redis://localhost:6379/1

# NATS Configuration
NATS_URL=nats://localhost:4222

# Email Configuration (Development uses console backend)
EMAIL_HOST=smtp.gmail.com
EMAIL_USE_SSL=ON
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@oxiliere.com

# Default Admin Configuration
DEFAULT_ADMIN_EMAIL=admin@oxiliere.com
DEFAULT_ADMIN_PWD=p@ass_ox_ADM1N


# WEB HOOK
DJANGO_WEBHOOK_MODE = "CONSOLE" 
